<mujoco model="panda manipulation">
    <include file="../assets/mujoco_menagerie/franka_emika_panda/panda.xml"/>

    <statistic center="0.3 0 0.3" extent="0.8"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"
                   specular="0 0 0"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

        <!-- Ground -->
        <geom name="floor" type="plane" pos="0 0 0"
              size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

        <!-- Object to pick up from the floor -->
        <body name="block" pos="0.4 0 0.05">
            <freejoint/>
            <geom name="block_geom" type="box"
                  size="0.04 0.04 0.04"
                  mass="0.1"
                  rgba="1 0.45 0.05 1"
                  friction="1.5 0.01 0.001"/>
        </body>
    </worldbody>
</mujoco>